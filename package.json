{
  "name": "cs-myfree",
  "version": "1.9.20",
  "type": "module",
  "description": "Myfree — 提供 18 个 AI 渠道接入。",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compat": {
      "tested": [
        ">=0.2.1-rc.2"
      ],
      "note": "宿主 rc1 也能加载（宿主机兼容层 + 客户端防御式注册）"
    }
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:static": "bash test/ci-static.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/7358716/cs-myfree.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
